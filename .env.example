# Пример конфигурации окружения для «ТГУ: Навигатор возможностей».
# Скопируйте этот файл в .env и заполните значения.
# Файл .env НИКОГДА не коммитится в репозиторий (см. .gitignore).

# Строка подключения к PostgreSQL (с образом pgvector/pgvector:pg16 по умолчанию)
DATABASE_URL=

# Провайдер LLM: mock | openai_compatible
LLM_PROVIDER=mock

# База URL OpenAI-совместимого API (например https://api.openai.com/v1)
LLM_API_BASE=

# Ключ API (пусто = используется mock-провайдер, сеть не требуется)
LLM_API_KEY=

# Название модели LLM
LLM_MODEL=

# Токен Telegram-бота (получить у @BotFather)
TG_BOT_TOKEN=

# Окружение приложения: development | production
APP_ENV=development

# --- Конвейер сбора данных (ingestion) ---
# Стартовые URL страниц ТГУ для парсинга анонсов (через запятую)
INGEST_START_URLS=https://news.tsu.ru/calendar-of-events/,https://vestnik.tsu.ru/
# Задержка между запросами к сайту, секунд (вежливость к серверу)
INGEST_DELAY_SECONDS=1.5
# Дней без подтверждения источником, после чего parsed-запись закрывается
INGEST_STALE_DAYS=45
